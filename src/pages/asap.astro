  .hr-link:hover { color: rgba(244,86,32,0.8); }
  .footer-link { text-decoration: none; padding-bottom: 1px; color: rgba(17,17,17,1); transition: color .15s ease; }
  .footer-link:hover { color: rgba(136,136,136,1); }
</style>

