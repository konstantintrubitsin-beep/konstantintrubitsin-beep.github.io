---
import Asap from '../layouts/Asap.astro';
---
<Asap>
<style is:inline>
  html, body { width:100%; height:100%; margin:0; padding:0; background:#f4f4f4; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
  .page { position: relative; width: 1024px; height: 672px; overflow: hidden; background: #f4f4f4; margin: 0 auto; }
  .page-content { position: absolute; width: 1024px; height: 572px; top: 54.127px; left: 6px; zoom: 0.988417; }
  .fixed-layer { position: absolute; inset: 0; pointer-events: none; }
  .fixed-layer > * { pointer-events: auto; }
  .widget { position: absolute; box-sizing: border-box; }
  .widget p { margin: 0; padding: 0; }
  .v { font-family: 'custom_87492', Arial, sans-serif; }
  .v94511 { font-family: 'custom_94511', Arial, sans-serif; }
  .wordmark-wrap { width: 883px; height: 342.56px; }
  .wordmark-wrap svg { width: 100%; height: 100%; display: block; }
  .asap-gif { position: absolute; overflow: hidden; }
  .asap-gif img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .name-link { text-decoration: none; padding-bottom: 1px; color: rgba(17,17,17,1); transition: color .15s ease; }
  .name-link:hover { color: rgba(136,136,136,1); }
  .asap-link { text-decoration: none; padding-bottom: 1px; color: rgba(136,136,136,1); transition: color .15s ease; }
  .asap-link:hover { color: rgba(244,86,32,0.8); }
  .vimeo-link { text-decoration: none; padding-bottom: 1px; color: rgba(136,136,136,1); transition: color .15s ease; }
  .vimeo-link:hover { color: rgba(97,211,250,1); }
  .max-link { text-decoration: none; padding-bottom: 1px; color: rgba(136,136,136,1); transition: color .15s ease; }
  .max-link:hover { color: rgba(255,170,199,1); }
  .asya-link { text-decoration: none; padding-bottom: 1px; color: rgba(136,136,136,1); transition: color .15s ease; }
  .asya-link:hover { color: rgba(157,107,246,1); }
  .lena-link { text-decoration: none; padding-bottom: 1px; color: rgba(136,136,136,1); transition: color .15s ease; }
  .lena-link:hover { color: rgba(255,209,3,1); }
  .team-link { text-decoration: none; padding-bottom: 1px; color: rgba(136,136,136,1); transition: color .15s ease; }
