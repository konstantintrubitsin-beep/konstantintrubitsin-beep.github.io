</article>

<script is:inline>
  (function () {
    var targets = document.querySelectorAll('[data-hover-target]');
    targets.forEach(function (el) {
      var id = el.getAttribute('data-hover-target');
      var layer = document.querySelector('[data-hover-id="' + id + '"]');
      if (!layer) return;
      el.addEventListener('mouseenter', function () {
        document.querySelectorAll('[data-hover-id]').forEach(function (l) { l.style.opacity = '0'; });
        layer.style.opacity = '1';
      });
      el.addEventListener('mouseleave', function () {
        layer.style.opacity = '0';
      });
    });
  })();
</script>
</Asap>
