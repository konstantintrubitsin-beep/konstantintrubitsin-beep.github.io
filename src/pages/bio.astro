---
import Base from '../layouts/Base.astro';

const navigation = [
  ['photographs', 'Commerce'],
  ['', 'Art'],
  ['bio', 'Обо мне'],
];
---

<Base title="Константин Трубицин — Обо мне">
  <nav class="site-nav" aria-label="Primary navigation">
    {navigation.map(([path, label]) => <a class:list={{ active: path === 'bio' }} href={`/${path}`}>{label}</a>)}
  </nav>

  <div class="text-page">
    <div class="text-page-content bio-content">
      <img class="bio-photo" src="/media/posters/konstantin-bio-2026.jpeg" alt="Константин Трубицин" fetchpriority="high" />
      <div>Константин Трубицин</div>
      <br /><br />
      <div>Дизайнер, AI-креатор</div>
      <br />
      <div>Два года коммерческого опыта на проектах в роли дизайнера и AI-креатора</div>
      <br />
      <div>Клиенты</div>
      <br />
      <div>
        <a href="https://rocketbank.ru/?utm_referrer=https%3A%2F%2Fwww.google.com%2F" target="_blank" rel="noreferrer">Рокетбанк</a><br />
        <a href="https://rubrick.ru" target="_blank" rel="noreferrer">Рубрик</a><br />
        <a href="https://www.devfest.ru" target="_blank" rel="noreferrer">ДевФест</a><br />
        <a href="https://seasoned.ru" target="_blank" rel="noreferrer">Seasoned</a>
        <br /><br />
        Telegram: <a href="https://t.me/konstantrubitsin" target="_blank" rel="noreferrer">@konstantrubitsin</a>
        <br />
        Email: <a href="mailto:kosta.trubitzin@gmail.com">kosta.trubitzin@gmail.com</a>
        <br /><br />
        <a href="/konstantin-trubitsin-resume.pdf" download>Скачать резюме</a>
      </div>
    </div>
  </div>
</Base>
