---
const { item, index = 0, selected = false } = Astro.props;
const label = item.label || `${item.category} media ${index + 1}`;
const poster = item.poster || (item.mediaType === 'video'
  ? `/media/posters/video/${item.src.split('/').at(-1)?.replace(/\.[^.]+$/, '.jpg')}`
  : null);
---

<button
  type="button"
  class:list={['media-card', { 'is-selected': selected }]}
  data-media-card
  data-media-caption={item.caption || ''}
  id={`target-${item.sourceId}`}
  aria-label={`Open ${label}`}
  style={`aspect-ratio: ${item.width || 800} / ${item.height || 600}`}
>
  {item.mediaType === 'video' ? (
    <>
      <video data-video-src={item.src} data-cover-only={item.coverOnly ? 'true' : undefined} poster={poster} autoplay muted loop playsinline preload="none" aria-label={label} />
      <img class="media-poster" src={poster} alt="" aria-hidden="true" loading="eager" decoding="async" />
    </>
  ) : (
    <img src={item.src} alt={label} loading="lazy" />
  )}
</button>
