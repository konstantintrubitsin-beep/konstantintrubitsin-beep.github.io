:0,"sides":3,"raster":null},{"id":"6761e4dc07ba9533e2158eae","type":"shape","z":347,"zPhone":347,"d":null,"p":{"x":10,"y":4316,"w":300,"h":8},"fixed":null,"hidden":true,"hiddenPhone":false,"anim":[],"shape":"line","color":null,"opacity":1,"weight":0.3,"radius":0,"sides":3,"raster":null},{"id":"6761e4dc07ba9533e2158eaf","type":"shape","z":348,"zPhone":348,"d":null,"p":{"x":-646,"y":4202,"w":445,"h":80},"fixed":null,"hidden":true,"hiddenPhone":false,"anim":[],"shape":"rectangle","color":null,"opacity":1,"weight":1,"radius":0,"sides":3,"raster":null},{"id":"6761e4dc07ba9533e2158eb0","type":"text","z":349,"zPhone":349,"d":null,"p":{"x":163,"y":4661.4,"w":118,"h":28},"fixed":null,"hidden":true,"hiddenPhone":false,"anim":[],"html":"<p class=\"al-left\" style=\"\">Coslovs (c)\n2017 — Present</p>","valign":"top","autosize":true},{"id":"6761e4dc07ba9533e2158eb1","type":"shape","z":350,"zPhone":350,"d":null,"p":{"x":10,"y":4654.4,"w":300,"h":4},"fixed":null,"hidden":true,"hiddenPhone":false,"anim":[],"shape":"line","color":"#FF0000","opacity":1,"weight":0.3,"radius":0,"sides":3,"raster":null},{"id":"6761e4dc07ba9533e2158eb4","type":"shape","z":351,"zPhone":351,"d":{"x":20,"y":620,"w":984,"h":8},"p":{"x":801,"y":533,"w":482,"h":8},"fixed":null,"hidden":false,"hiddenPhone":false,"anim":[],"shape":"line","color":"#C4C4C4","opacity":1,"weight":0.3,"radius":0,"sides":3,"raster":null},{"id":"6761e4dc07ba9533e2158eb5","type":"text","z":352,"zPhone":352,"d":null,"p":{"x":583,"y":429.6,"w":84,"h":14},"fixed":null,"hidden":true,"hiddenPhone":false,"anim":[],"html":"<p class=\"al-left\" style=\"\">A few words:</p>","valign":"top","autosize":true},{"id":"6761e4dc07ba9533e2158eb6","type":"shape","z":353,"zPhone":353,"d":null,"p":{"x":583,"y":445.6,"w":300,"h":4},"fixed":null,"hidden":true,"hiddenPhone":false,"anim":[],"shape":"line","color":null,"opacity":1,"weight":0.3,"radius":0,"sides":3,"raster":null},{"id":"6761e4dc07ba9533e2158eb7","type":"text","z":354,"zPhone":354,"d":null,"p":{"x":583,"y":454.2,"w":300,"h":780},"fixed":null,"hidden":true,"hiddenPhone":false,"anim":[],"html":"<p class=\"al-left\" style=\"\">Still waters run deep. I will tell you a little more about this image and symbols in Russian fairy tales, and you can learn more about the meaning I put into it and the symbols I used at my workshop on November 6.\r</p><p class=\"al-left\" style=\"\">ВЪСУЕ (from Old Russian: in vain, in vain) is a story about struggle, acceptance and rebirth.\r</p><p class=\"al-left\" style=\"\">Prototypes: Koschei the Deathless, Baba Yaga, Pushkin's Swan Princess, Sirin, Matryoshka.\r</p><p class=\"al-left\" style=\"\">And now about the symbolism in Russian fairy tales: they often mention the number seven - &quot;behind seven doors, behind seven locks ...&quot;, &quot;seven-flower&quot;. The number seven is again a designation of the stages of the path to oneself, the keys to achieving higher wisdom. These stages are: the health of the physical body and unity with it; internal &quot;spark&quot;; acceptance and love for everything around; mind-reason; consciousness; superconsciousness. After passing all these stages, \na person opens up to the highest level - clairvoyance, this will be key number seven. Numerology encodes the deep meaning of a person's knowledge of himself and the world, and in Russian folk tales, the issue of spiritual growth, gaining wisdom, striving for goodness and light turns out to be paramount.Welcome to the world of insurance! Initially, it may seem dark, ugly, hopeless, deadly, menacing, leaving a deep mark, but in this darkness, another side can be traced: brighter, kinder, forcing you to finally show yourself. After all, this world is a Man. A living, sensual and different Man, who can hide himself and his feelings in various fears and vices. A Man is born, fears surround him, they think, creating problems, eternal throwing. \nA Man grows, does not quite understand how to do \nяit right, what is right and whether it exists - it gets bumps, tries to load itself into fears that have already been absorbed under the casing as much as possible. At this moment, they hold us, not allowing decline. \nA Man accepts you, understands that he can &quot;be friends&quot; with them, realize, cherish and be attentive. Fears save us and show us the way. A Man accepts himself, his life, his fears, and knows how to live with them. Liberation and formation occur. These four stages are shown through a modern canvas and a homage to the Renaissance. Then, in the story, each fear in this world will gradually be revealed.\r</p><p class=\"al-left\" style=\"\">The project &quot;Revival of Insurance&quot;, born in the darkest period and based on the analysis of natural insurance. Being in a difficult emotional state every day, I thought about the root cause and motivation to &quot;suffer&quot;. Everything that previously forced me to overcome difficulties and reach new heights ceased to work. \nI began to tactilely feel and see the fears that surrounded society.</p>","valign":"top","autosize":true},{"id":"6761e4dc07ba9533e2158eb8","type":"text","z":355,"zPhone":355,"d":null,"p":{"x":609,"y":588.6,"w":234,"h":135},"fixed":null,"hidden":true,"hiddenPhone":false,"anim":[],"html":"<p class=\"al-left\" style=\"\">beam.contact\nElena Kozlova\nDaria Kudina, \nAlesya Simonova\nDaniel Grinko\nOlga Milich\nJulia Vyalkina\nElvis Ruma\nJulia Tribusyan</p>","valign":"top","autosize":true},{"id":"6761e4dc07ba9533e2158ec4","type":"shape","z":367,"zPhone":367,"d":{"x":20.1,"y":2303.33,"w":984,"h":4},"p":{"x":1674.1,"y":4416.32,"w":984,"h":4},"fixed":null,"hidden":false,"hiddenPhone":false,"anim":[],"shape":"line","color":"#FF0000","opacity":1,"weight":0.3,"radius":0,"sides":3,"raster":null},{"id":"6761e4dc07ba9533e2158ec5","type":"text","z":368,"zPhone":368,"d":{"x":20,"y":2287,"w":242,"h":14},"p":{"x":1674,"y":4400.99,"w":242,"h":14},"fixed":null,"hidden":false,"hiddenPhone":false,"anim":[],"html":"<p class=\"al-left\" style=\"lin